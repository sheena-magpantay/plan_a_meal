# Copy to .env and fill in. .env is git-ignored; this file is committed.
#
# Every VITE_ value is compiled into the built JavaScript and is PUBLIC.
# Never put a key, a password or a connection string in here.

# Demo mode is the DEFAULT. Only the exact value "false" turns it off, so an
# unset or mistyped variable leaves you on the simulated backend with a visible
# notice, rather than on a silently broken build.
#   unset or true  = simulated backend, no server needed
#   false          = call the real API at VITE_API_BASE_URL
VITE_USE_MOCK_API=true

# Where your Express API lives. Ignored while VITE_USE_MOCK_API is true.
# Local: http://localhost:3000     Deployed: https://your-api.onrender.com
# No trailing slash.
VITE_API_BASE_URL=http://localhost:3000

# Supabase: accounts (email + password, and Google) and each user's saved week.
# When BOTH are set, the app asks visitors to log in and saves to Supabase,
# whatever VITE_USE_MOCK_API says. Leave them empty to run without accounts.
# Supabase dashboard > Project Settings > API: the project URL and the
# publishable (anon) key. The publishable key is designed to be public; Row
# Level Security in supabase/schema.sql is what protects each user's data.
# NEVER put the secret / service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
